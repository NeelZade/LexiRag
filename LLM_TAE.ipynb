        "import threading\n",
        "import subprocess\n",
        "import time\n",
        "\n",
        "# 1. Start the server in a dedicated background thread\n",
        "def run_ollama_serve():\n",
        "    subprocess.run([\"ollama\", \"serve\"])\n",
        "\n",
        "thread = threading.Thread(target=run_ollama_serve, daemon=True)\n",
        "thread.start()\n",
        "\n",
        "# 2. Give it a few seconds to boot up\n",
        "time.sleep(5)\n",
        "print(\"✅ Ollama server is running in the background.\")\n",
        "\n",
        "# 3. Pull the embedding model (just to be safe)\n",
        "!ollama pull nomic-embed-text"
